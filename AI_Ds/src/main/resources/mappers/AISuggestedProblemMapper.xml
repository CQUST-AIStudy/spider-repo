<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cqust.ai_server.dao.AISuggestedProblemDao">
    <!-- 查询结果映射 -->
    <resultMap id="aiSuggestedProblemResultMap" type="com.cqust.ai_server.entity.AISuggestedProblem">
        <result property="studentName" column="student_name"/>
        <result property="content" column="PTAURLS"/>
    </resultMap>

<!--    &lt;!&ndash; 根据学生ID和实验ID查询 &ndash;&gt;-->
<!--    <select id="findByStudentIdAndExperimentId" resultMap="aiSuggestedProblemResultMap">-->
<!--        SELECT * FROM AI_suggested_problems -->
<!--        WHERE student_id = #{studentId} AND experiment_id = #{experimentId}-->
<!--    </select>-->

    <!-- 根据学生ID查询所有推荐 -->
    <select id="findByStudentId" resultMap="aiSuggestedProblemResultMap">
        SELECT ap.*
        FROM ai_pta_suggested_url ap
                 JOIN student s ON ap.student_name = s.name
        WHERE s.student_id = #{studentId};
    </select>

