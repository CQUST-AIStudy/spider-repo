# PTA account used when a teacher sync request does not provide temporary credentials.
PTA_USERNAME=
PTA_PASSWORD=

# Optional default precise sync scope. In normal production flow these values
# are passed by the backend per teaching class.
PTA_GROUP_ID=
PTA_GROUP_NAME=
PTA_INCLUDE_ARCHIVED_USER_GROUPS=true
PTA_USER_GROUP_FUZZY_MIN_SCORE=0.82

# Cloud/container runtime. Keep headless enabled on servers without GUI.
PTA_HEADLESS=true
PTA_FORCE_SELENIUM_LOGIN=false
PTA_KEEP_BROWSER_OPEN_ON_FAILURE=false
PTA_SELENIUM_FORM_WAIT_SECONDS=8

# Container paths. docker-compose.yml also sets these explicitly.
PTA_RUNTIME_DIR=/app/runtime
PTA_CRAWL_DIR=/app/output
PTA_BROWSER_HOME=/app/runtime/browser
PTA_CHROME_BINARY=/usr/bin/chromium
PTA_CHROMEDRIVER_PATH=/usr/bin/chromedriver

# PTA Spider API
SPIDER_PORT=8100
SPIDER_CORS_ALLOW_ORIGINS=*

# Java backend callback URL. For standalone Docker, host.docker.internal points
# to a backend exposed on the host. In the root compose, this is overridden to
# http://backend:8081.
JAVA_BACKEND_URL=http://host.docker.internal:8081

# Refresh policy: open problem sets refresh daily; forced sync bypasses cooldown.
COOLDOWN_SUBMISSIONS=86400
COOLDOWN_EXPORTS=86400

# ---- Crawl throughput (aggressive defaults; lower to roll back) ----
# Target steady-state PTA API requests per minute (adaptive; max ramp target).
# Range 1-180. On 429 the rate halves down to PTA_API_RATE_LIMIT_MIN, then recovers.
PTA_API_RATE_LIMIT_PER_MINUTE=60
PTA_API_RATE_LIMIT_MIN=10
# Concurrent problem-detail fetches within one problem set.
PTA_DETAIL_MAX_WORKERS=12
# Concurrent problem sets within one crawl task (content/submissions/exports).
PTA_PROBLEM_SET_MAX_WORKERS=3
# Export pipeline: poll interval, delay after create, delay between serial exports.
PTA_EXPORT_POLL_INTERVAL_SECONDS=1.0
PTA_EXPORT_CREATE_DELAY_SECONDS=0.5
PTA_EXPORT_BETWEEN_DELAY_SECONDS=0.5
# Parallel PAPER_TRANSCRIPT + SCORED_CODE within one problem set (true/false).
PTA_EXPORT_PARALLEL=true
# Export retry policy.
PTA_EXPORT_RETRY_ROUNDS=2
PTA_EXPORT_RETRY_DELAY_SECONDS=20
# 用户组答卷导出失败时是否阻止成绩单/得分代码继续同步。
# 默认 false：答卷是补充证据，失败会记录 warning 并继续核心同步。
PTA_GROUP_ANSWER_EXPORT_REQUIRED=false

# Database used by legacy/unified sync. Use a remote host/IP, host.docker.internal,
# or a compose service name when MySQL is in the same Docker network.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=ptadatabase
DB_USERNAME=root
DB_PASSWORD=
