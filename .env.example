# PTA account used when a teacher sync request does not provide temporary credentials.
PTA_USERNAME=
PTA_PASSWORD=

# Optional default precise sync scope. In normal production flow these values
# are passed by the backend per teaching class.
PTA_GROUP_ID=
PTA_GROUP_NAME=

# Cloud/container runtime. Keep headless enabled on servers without GUI.
PTA_HEADLESS=true
PTA_FORCE_SELENIUM_LOGIN=false
PTA_KEEP_BROWSER_OPEN_ON_FAILURE=false
PTA_SELENIUM_FORM_WAIT_SECONDS=8

# Container paths. docker-compose.yml also sets these explicitly.
PTA_RUNTIME_DIR=/app/runtime
PTA_CRAWL_DIR=/app/output
PTA_BROWSER_HOME=/app/runtime/browser
PTA_CHROME_BINARY=/usr/bin/google-chrome
PTA_CHROMEDRIVER_PATH=/usr/bin/chromedriver

# PTA Spider API
SPIDER_PORT=8100
SPIDER_CORS_ALLOW_ORIGINS=*

# Java backend callback URL. Do not use 127.0.0.1 in Docker unless the backend
# is in the same container. Use a compose service name, private IP, or domain.
JAVA_BACKEND_URL=http://backend:8081

# Refresh policy: open problem sets refresh daily; forced sync bypasses cooldown.
COOLDOWN_SUBMISSIONS=86400
COOLDOWN_EXPORTS=86400

# Database used by legacy/unified sync.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ptadatabase
DB_USERNAME=root
DB_PASSWORD=
