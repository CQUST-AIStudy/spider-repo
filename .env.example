PTA_USERNAME=
PTA_PASSWORD=
PTA_GROUP_ID=
PTA_GROUP_NAME=
PTA_HEADLESS=true
PTA_FORCE_SELENIUM_LOGIN=false
PTA_RUNTIME_DIR=
PTA_CRAWL_DIR=
PTA_BROWSER_HOME=
PTA_CHROME_BINARY=
PTA_CHROMEDRIVER_PATH=
JAVA_BACKEND_URL=http://127.0.0.1:8081
SPIDER_PORT=8100
SPIDER_CORS_ALLOW_ORIGINS=*
COOLDOWN_SUBMISSIONS=86400
COOLDOWN_EXPORTS=86400
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ptadatabase
DB_USERNAME=root
DB_PASSWORD=

# ===== Docker 部署补充（docker compose up -d --build 时使用）=====
# Java 后端地址（spider 把爬取结果同步给后端），按实际填写
JAVA_BACKEND_URL=http://127.0.0.1:8081
# spider_api 监听端口，需与 docker-compose.yml 的端口映射一致
SPIDER_PORT=8100
# 容器内 Chrome / chromedriver 路径（镜像已固定，一般无需改）
PTA_CHROME_BINARY=/usr/bin/google-chrome
PTA_CHROMEDRIVER_PATH=/usr/bin/chromedriver
# 容器内必须 headless
PTA_HEADLESS=true
PTA_KEEP_BROWSER_OPEN_ON_FAILURE=false
